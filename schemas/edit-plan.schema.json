{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://top-video.local/schemas/edit-plan.schema.json",
  "title": "TOP VIDEO Edit Plan",
  "description": "Plano estruturado e limitado de edição. Não contém código executável nem URLs arbitrárias.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "aspectRatio",
    "fps",
    "source",
    "edits",
    "captions",
    "graphics",
    "audio",
    "mode",
    "analysis",
    "assetSuggestions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "aspectRatio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ]
    },
    "fps": {
      "type": "integer",
      "enum": [
        24,
        25,
        30,
        60
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSeconds"
      ],
      "properties": {
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1800
        }
      }
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "startSeconds",
          "endSeconds"
        ],
        "properties": {
          "type": {
            "enum": [
              "keep",
              "remove",
              "trim"
            ]
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "maxItems": 100
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "startSeconds",
          "endSeconds",
          "style"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "style": {
            "enum": [
              "white",
              "white_yellow",
              "green"
            ]
          }
        }
      },
      "maxItems": 300
    },
    "graphics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "startSeconds",
          "endSeconds"
        ],
        "properties": {
          "kind": {
            "enum": [
              "title",
              "lower_third",
              "callout",
              "arrow",
              "shape",
              "simple_2d"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 180
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "position": {
            "enum": [
              "top",
              "center",
              "bottom"
            ]
          }
        }
      },
      "maxItems": 100
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noiseReduction",
        "music"
      ],
      "properties": {
        "noiseReduction": {
          "type": "boolean"
        },
        "music": {
          "enum": [
            "none",
            "user_provided",
            "licensed_library"
          ]
        },
        "musicVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "mode": {
      "const": "hybrid"
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "scenes"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 1200
        },
        "scenes": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startSeconds",
              "endSeconds",
              "description",
              "visualElements",
              "editingOpportunity"
            ],
            "properties": {
              "startSeconds": {
                "type": "number",
                "minimum": 0
              },
              "endSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "visualElements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 120
                },
                "maxItems": 12
              },
              "editingOpportunity": {
                "type": "string",
                "maxLength": 400
              }
            }
          }
        }
      }
    },
    "assetSuggestions": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "prompt",
          "startSeconds",
          "endSeconds",
          "reason"
        ],
        "properties": {
          "kind": {
            "enum": [
              "image",
              "illustration",
              "2d_motion",
              "3d_object"
            ]
          },
          "prompt": {
            "type": "string",
            "maxLength": 500
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
