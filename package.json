{
  "name": "top-video",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud-ready AI-assisted video editing project built with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Main out/video.mp4",
    "api": "node --env-file-if-exists=.env server/index.mjs",
    "api:dev": "node --watch --env-file-if-exists=.env server/index.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@remotion/cli": "latest",
    "@remotion/renderer": "latest",
    "remotion": "latest",
    "react": "latest",
    "react-dom": "latest",
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.2.1",
    "ajv": "^8.17.1",
    "@remotion/bundler": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
