# Copie para .env local e gere um token aleatório longo (mínimo 24 caracteres).
# Nunca envie este arquivo real ao GitHub.
TOP_VIDEO_API_TOKEN=troque-por-um-token-aleatorio-com-mais-de-24-caracteres
PORT=8787
HOST=0.0.0.0
TOP_VIDEO_STORAGE=./storage/jobs

# Chave da API OpenAI: mantenha apenas no ambiente privado do servidor.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
